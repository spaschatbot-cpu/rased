# ── Sessions ────────────────────────────────────────────────────────
# Required in production. Any long random string; rotating it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Accounts ────────────────────────────────────────────────────────
# Read once, the first time the backend runs, to seed the account table.
# Changing them later has no effect — delete the `users` key in the store
# (or .data/store.json locally) to re-seed.
#
# ADMIN_PASSWORD sets the `superadmin` account. It is REQUIRED in production:
# without it the backend refuses to seed rather than create a superadmin whose
# password is published in this repository.
ADMIN_PASSWORD=
#
# DEMO_PASSWORD sets every other seeded account (the Lamar admins, the viewer,
# the two drivers). Leave it blank in production and those accounts are simply
# not created — you get a superadmin, and you add real people from the
# Management screen. Locally, blank means the defaults in api/_lib/users.js.
DEMO_PASSWORD=

# ── Storage ─────────────────────────────────────────────────────────
# Leave everything below blank locally: the backend falls back to
# .data/store.json, so `npm run dev` needs no account and no network.
#
# Three drivers, chosen in this order. See api/_lib/store.js.

# 1. Supabase — preferred in production. Its free tier is bounded by
#    megabytes, not by request count, and this backend's cost is
#    request-shaped: a dashboard polls for as long as it stays open.
#    Run scripts/supabase-schema.sql once before pointing at a project.
#
#    The SERVICE ROLE key, not the anon one. The kv table has RLS on and
#    no policies, so only a key that bypasses RLS can reach it — which is
#    also why this value must never reach the browser bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Upstash Redis — faster per call, billed per command. On Vercel its
#    integration injects these for you (the KV_* names are also accepted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
